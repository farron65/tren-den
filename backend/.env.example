# Must use the async driver: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
# For local Docker setup: postgresql+asyncpg://admin:secret@db:5432/mydb

SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALGORITHM=HS256
RESEND_EMAIL_API_KEY=your-resend-api-key

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://trenden.netlify.app

BOT_API_KEY=SuperDuperSecret
BOT_USERNAME=YourUserName